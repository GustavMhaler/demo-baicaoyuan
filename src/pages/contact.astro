---
// Utils
import { getImage } from "astro:assets";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import InquiryForm from "@components/InquiryForm/InquiryForm.astro";

// Data
import { BUSINESS } from "@data/client";

// Images
import bannerImage from "@assets/images/hero/baicaoyuan-hero-origin-factory.png";
import infoImage from "@assets/images/hero/baicaoyuan-hero-oem-production.png";
const optimizedBanner = await getImage({ src: bannerImage, format: "webp" });
---

<BaseLayout title="联系询盘" description="提交合作需求：产品目录、报价与 OEM 打样方案由销售团队一对一对接。">
	<Banner title="联系询盘" image={optimizedBanner} />
	<InquiryForm
		email={BUSINESS.email}
		oemEmail="oem@baicaoyuan-tea.com"
		phones={[
			{ tel: BUSINESS.phoneForTel, display: `${BUSINESS.phoneFormatted}（总机）` },
			{ tel: BUSINESS.phoneSalesForTel, display: BUSINESS.phoneSalesFormatted },
		]}
		address={BUSINESS.address}
		hours="周一至周六 8:30 - 17:30"
		backgroundImage={infoImage}
	/>
</BaseLayout>
