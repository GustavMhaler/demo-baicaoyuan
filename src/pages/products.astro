---
// Utils
import { getImage } from "astro:assets";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import ProductCatalog from "@components/ProductCatalog/ProductCatalog.astro";
import CTASimple from "@components/CTA/CTASimple.astro";

// Images
import bannerImage from "@assets/images/hero/baicaoyuan-hero-origin-factory.png";
import product1 from "@assets/images/products/baicaoyuan-juhua-juemingzi.png";
import product2 from "@assets/images/products/baicaoyuan-hongzao-gouqi-jiangsi.png";
import product3 from "@assets/images/products/baicaoyuan-meigui-luoshen.png";
import product4 from "@assets/images/products/baicaoyuan-bozhou-chrysanthemum.png";
import product5 from "@assets/images/products/baicaoyuan-four-seasons-giftbox.png";
const optimizedBanner = await getImage({ src: bannerImage, format: "webp" });

// Product catalog (fictional demo data). Four products without photos are
// rendered as brand-colour tiles - no placeholder images are generated.
const products = [
	{ name: "菊花决明子茶", line: "经典组合茶", ingredients: "亳菊、决明子、枸杞、牛蒡根、金银花", spec: "5g×30包", price: "39.9", image: product1 },
	{ name: "红枣枸杞姜丝茶", line: "经典组合茶", ingredients: "新疆红枣、宁夏枸杞、小黄姜、红糖", spec: "12g×20包", price: "49.9", image: product2 },
	{ name: "玫瑰洛神花茶", line: "经典组合茶", ingredients: "平阴玫瑰、洛神花、陈皮、冰糖", spec: "6g×25包", price: "45.9", image: product3 },
	{ name: "冬瓜荷叶茶", line: "经典组合茶", ingredients: "冬瓜干、荷叶、决明子、陈皮、玫瑰花", spec: "5g×30包", price: "36.9" },
	{ name: "头采亳菊", line: "单一花材茶", ingredients: "亳州道地亳菊（地理标志产品）", spec: "50g/罐", price: "59.9", image: product4 },
	{ name: "金银花茶", line: "单一花材茶", ingredients: "河南封丘金银花", spec: "40g/罐", price: "69.9" },
	{ name: "玫瑰花茶", line: "单一花材茶", ingredients: "山东平阴重瓣红玫瑰", spec: "60g/罐", price: "55.9" },
	{ name: "四季养生礼盒", line: "礼盒系列", ingredients: "含 4 款组合茶，共 100 包", spec: "礼盒装", price: "198", image: product5 },
	{ name: "女性养颜礼盒", line: "礼盒系列", ingredients: "玫瑰茶、红枣茶、洛神花、桂圆", spec: "礼盒装", price: "168" },
];
---

<BaseLayout title="产品中心" description="百草源产品体系：经典组合茶、单一花材茶与礼盒系列共 28 款 SKU，面向批发、经销与 OEM 客户供货。">
	<Banner title="产品中心" image={optimizedBanner} variant="compact" />
	<ProductCatalog products={products} />
	<CTASimple
		title="想先拿样品"
		titleLineTwo="试试水？"
		text="样品按成本价供应，常规 3-5 天发出；批量订单确认后样品费可在货款中抵扣。"
		buttonText="提交询盘"
	/>
</BaseLayout>
