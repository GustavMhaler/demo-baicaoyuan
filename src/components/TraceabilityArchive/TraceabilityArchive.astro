---
// TraceabilityArchive: homepage traceability process section.
// New business-specific component; mother component is the Services card
// (cs-container / cs-content / cs-topper / cs-title / cs-text structure,
// white cards with 6px brand top border, 5px radius and the same soft shadow).
// Static visual only in this round - no scroll animation, no script.
---

<section id="traceability-archive">
	<div class="cs-container">
		<div class="cs-content">
			<span class="cs-topper">原料溯源</span>
			<h2 class="cs-title">从入厂到交付，每一步都可追溯</h2>
			<p class="cs-text">
				四阶段批次溯源与三级品控一一对应，批号贯穿原料、生产与成品环节。
			</p>
		</div>
		<div class="cs-archive-group" data-reveal>
			<div class="cs-card cs-card1" data-reveal style="--reveal-delay: 200ms">
				<span class="cs-step">01</span>
				<h3 class="cs-card-title">入厂检验</h3>
				<p class="cs-card-text">
					农残快检、水分检测与杂质筛选，原料合格后分区入库。
				</p>
			</div>
			<div class="cs-card cs-card2" data-reveal style="--reveal-delay: 360ms">
				<span class="cs-step">02</span>
				<h3 class="cs-card-title">生产巡检</h3>
				<p class="cs-card-text">
					十万级洁净车间作业，巡检记录按批次归档留痕。
				</p>
			</div>
			<div class="cs-card cs-card3" data-reveal style="--reveal-delay: 520ms">
				<span class="cs-step">03</span>
				<h3 class="cs-card-title">出厂检验</h3>
				<p class="cs-card-text">
					微生物检测、净含量检测与感官评审，逐批完成放行。
				</p>
			</div>
			<div class="cs-card cs-card4" data-reveal style="--reveal-delay: 680ms">
				<span class="cs-step">04</span>
				<h3 class="cs-card-title">交付</h3>
				<p class="cs-card-text">
					检测报告随货提供，批号可追溯至原料产地与批次。
				</p>
			</div>
		</div>
		<p class="cs-batch" data-reveal style="--reveal-delay: 900ms">
			批次状态：已交付 · 示例批号 DEMO-2026-0812-003
		</p>
	</div>
</section>

<style lang="less">
	/*-- -------------------------- -->
	<---    Traceability Archive   -->
	<--- -------------------------- -*/

	/* Mobile - 360px */
	@media only screen and (min-width: 0em) {
		#traceability-archive {
			padding: var(--sectionPadding);
			background: var(--secondary);
			position: relative;

			.cs-container {
				width: 100%;
				max-width: (1280/16rem);
				margin: auto;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				row-gap: (40/16rem);
			}

			.cs-content {
				text-align: center;
				width: 100%;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.cs-topper {
				margin-bottom: (16/16rem);
				color: var(--primaryLight);
			}

			.cs-title {
				/* 41px - 60px */
				max-width: (621/16rem);
				margin-bottom: (16/16rem);
				color: var(--bodyTextColorWhite);
			}

			.cs-text {
				max-width: (750/16rem);
				color: var(--bodyTextColorWhite);
				opacity: 0.85;
			}

			.cs-batch {
				font-size: (14/16rem);
				font-weight: 700;
				line-height: 1.6em;
				letter-spacing: 0.05em;
				text-align: center;
				width: auto;
				margin: 0;
				padding: (10/16rem) (18/16rem);
				color: var(--primaryLight);
				border: 1px solid rgba(214, 178, 118, 0.5);
				border-radius: (18/16rem);
				display: inline-block;
			}

			.cs-archive-group {
				width: 100%;
				position: relative;
				display: flex;
				justify-content: center;
				align-items: stretch;
				flex-wrap: wrap;
				gap: (24/16rem);
			}

			.cs-card {
				/* mother: Services .card surface values */
				width: 100%;
				max-width: (357/16em);
				margin: auto;
				box-sizing: border-box;
				padding: (50/16em) (20/16em);
				background: #fff;
				box-shadow: 0px 20px 40px rgba(0, 0, 0, 0.05);
				border-top: (6/16em) solid var(--primary);
				border-radius: (5/16em);
				display: block;
				text-align: center;
			}

			.cs-step {
				font-size: (14/16rem);
				font-weight: 700;
				line-height: 1.2em;
				letter-spacing: 0.1em;
				color: var(--primaryLight);
				display: block;
				margin-bottom: (12/16rem);
			}

			.cs-card-title {
				font-size: (24/16rem);
				font-weight: 700;
				line-height: 1.2em;
				color: var(--headerColor);
				margin-bottom: (12/16rem);
			}

			.cs-card-text {
				font-size: (15/16rem);
				line-height: 1.6em;
				width: 100%;
				color: var(--bodyTextColor);
				opacity: 0.75;
			}

			/* motion layer: stages light up in sequence */
			.cs-card[data-reveal] {
				transition: opacity 0.55s ease, transform 0.55s ease;
				transition-delay: var(--reveal-delay, 0ms);

				&.cs-reveal-pending {
					opacity: 0;
					transform: translateY(18px);
				}

				&.cs-revealed {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.cs-batch[data-reveal] {
				transition: opacity 0.6s ease, transform 0.6s ease;
				transition-delay: var(--reveal-delay, 0ms);

				&.cs-reveal-pending {
					opacity: 0;
					transform: translateY(12px);
				}

				&.cs-revealed {
					opacity: 1;
					transform: translateY(0);
				}
			}
		}
	}

	/* Tablet - 768px */
	@media only screen and (min-width: 48rem) {
		#traceability-archive {
			.cs-card {
				/* two columns: (50% - half of the 24px gap) */
				width: calc(50% - 0.75rem);
				max-width: none;
				margin: 0;
			}
		}
	}

	/* Desktop - 1024px */
	@media only screen and (min-width: 64rem) {
		#traceability-archive {
			.cs-archive-group {
				/* four cards on one row; clear the mother card's 357px max-width
				   that would wrap the row into 2x2 on wide viewports */
				flex-wrap: nowrap;
			}

			.cs-card {
				/* four columns: (25% - 3/4 of the 24px gap) */
				width: calc(25% - 1.125rem);
				max-width: none;
				margin: 0;
			}

			.cs-archive-group {
				&:before {
					/* subtle flow line behind the step markers */
					content: "";
					width: 100%;
					height: 1px;
					background: rgba(250, 250, 246, 0.35);
					display: block;
					position: absolute;
					top: (32/16rem);
					left: 0;
					pointer-events: none;
				}

				/* motion layer: the flow line draws across with the stages */
				&[data-reveal] {
					&:before {
						transform: scaleX(0);
						transform-origin: left;
						transition: transform 1s ease 0.1s;
					}

					&.cs-revealed {
						&:before {
							transform: scaleX(1);
						}
					}
				}
			}
		}
	}
</style>
