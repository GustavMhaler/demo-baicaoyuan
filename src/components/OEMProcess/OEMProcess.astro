---
// OEMProcess: OEM cooperation steps as a true flow line.
// Desktop: four nodes on one horizontal connector line (no cards).
// Mobile/tablet: vertical timeline. The sequence is structural, not four
// white cards. All styles are scoped.

interface ProcessStep {
	step: string;
	title: string;
	text: string;
	tag: string;
}

interface Props {
	steps: ProcessStep[];
}

const { steps } = Astro.props as Props;
---

<section id="oem-process">
	<div class="cs-container">
		<div class="cs-content">
			<span class="cs-topper">合作流程</span>
			<h2 class="cs-title">四步完成你的专属产品</h2>
			<p class="cs-text">从需求沟通到批量交付，每个节点都有专人对接、书面确认。</p>
		</div>
		<ol class="cs-flow">
			{steps.map((s) => (
				<li class="cs-node">
					<span class="cs-node-dot" aria-hidden="true">{s.step}</span>
					<div class="cs-node-body">
						<h3 class="cs-node-title">{s.title}</h3>
						<p class="cs-node-text">{s.text}</p>
						<span class="cs-tag">{s.tag}</span>
					</div>
				</li>
			))}
		</ol>
	</div>
</section>

<style lang="less">
	/*-- -------------------------- -->
	<---        OEM Process        -->
	<--- -------------------------- -*/

	/* Mobile - 360px: vertical timeline */
	@media only screen and (min-width: 0em) {
		#oem-process {
			padding: var(--sectionPadding);
			background: var(--bodyTextColorWhite);
			position: relative;

			.cs-container {
				width: 100%;
				max-width: (1280/16rem);
				margin: auto;
				display: flex;
				flex-direction: column;
				align-items: center;
				row-gap: (40/16rem);
			}

			.cs-content {
				text-align: center;
				width: 100%;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.cs-topper {
				margin-bottom: (16/16rem);
			}

			.cs-title {
				max-width: (621/16rem);
				margin-bottom: (16/16rem);
			}

			.cs-text {
				max-width: (750/16rem);
			}

			.cs-flow {
				width: 100%;
				max-width: (600/16rem);
				margin: 0;
				padding: (8/16rem) 0 0 0;
				list-style: none;
				position: relative;

				&:before {
					/* vertical timeline rail */
					content: "";
					width: 2px;
					height: calc(100% - (32/16rem));
					background: rgba(23, 63, 53, 0.18);
					display: block;
					position: absolute;
					top: (16/16rem);
					left: (23/16rem);
				}
			}

			.cs-node {
				position: relative;
				display: flex;
				align-items: flex-start;
				gap: (24/16rem);
				padding-bottom: (36/16rem);

				&:last-of-type {
					padding-bottom: 0;
				}
			}

			.cs-node-dot {
				/* mother: Services icon circle sizing */
				font-size: (14/16rem);
				font-weight: 700;
				line-height: (48/16rem);
				text-align: center;
				width: (48/16rem);
				height: (48/16rem);
				flex: none;
				color: var(--bodyTextColorWhite);
				background-color: var(--secondary);
				border: 3px solid var(--bodyTextColorWhite);
				border-radius: 50%;
				box-shadow: 0 0 0 2px var(--primary);
				display: block;
				position: relative;
				z-index: 1;
			}

			.cs-node-body {
				flex: 1;
				padding-top: (6/16rem);
			}

			.cs-node-title {
				font-size: (20/16rem);
				font-weight: 700;
				line-height: 1.3em;
				margin-bottom: (8/16rem);
				color: var(--headerColor);
			}

			.cs-node-text {
				font-size: (15/16rem);
				line-height: 1.6em;
				margin-bottom: (12/16rem);
				color: var(--bodyTextColor);
				opacity: 0.75;
			}

			.cs-tag {
				font-size: (13/16rem);
				font-weight: 700;
				line-height: (28/16rem);
				padding: 0 (14/16rem);
				color: var(--secondary);
				background-color: rgba(23, 63, 53, 0.08);
				border-radius: (14/16rem);
				display: inline-block;
			}
		}
	}

	/* Tablet - 768px: keep timeline, two-column nodes */
	@media only screen and (min-width: 48rem) {
		#oem-process {
			.cs-flow {
				max-width: (800/16rem);
			}
		}
	}

	/* Desktop - 1024px: horizontal flow line */
	@media only screen and (min-width: 64rem) {
		#oem-process {
			.cs-flow {
				max-width: none;
				padding: (8/16rem) 0 0 0;
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				gap: (32/16rem);

				&:before {
					/* horizontal connector line through the node dots
					   (from first dot centre to last dot centre) */
					content: "";
					width: calc(100% - 3rem);
					height: 2px;
					background: rgba(23, 63, 53, 0.18);
					display: block;
					position: absolute;
					top: (23/16rem);
					left: 1.5rem;
				}
			}

			.cs-node {
				/* four columns: (25% - 3/4 of the 32px gap) */
				width: calc(25% - 1.5rem);
				flex: none;
				padding-bottom: 0;
				flex-direction: column;
				align-items: center;
				text-align: center;
			}

			.cs-node-body {
				padding-top: (20/16rem);
			}
		}
	}
</style>
