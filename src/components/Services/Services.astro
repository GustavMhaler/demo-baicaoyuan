---
// Utils
import { Icon } from 'astro-icon/components';

// Content-driven services row. DOM, scoped LESS and breakpoints are unchanged
// from the template; only the three card entries come from props
// (defaults = homepage services).
interface ServiceItem {
	icon: string; // icon name in src/icons/
	title: string;
	text: string;
}

interface Props {
	items?: ServiceItem[];
}

const {
	items = [
		{
			icon: "service1",
			title: "产品供货",
			text: "经典组合茶、单一花材茶与礼盒系列，配方成熟、规格齐全，支持批发与一件代发。",
		},
		{
			icon: "service2",
			title: "OEM/ODM",
			text: "从配方打样、包装确认到标准化生产一站式交付，袋泡茶最小起订量 5000 包。",
		},
		{
			icon: "service3",
			title: "三级品控",
			text: "原料入厂检验、生产过程巡检、成品出厂检验，每批产品检测报告留存 18 个月。",
		},
	],
} = Astro.props as Props;
---

<section id="services" class="services">
  {items.map((item, index) => (
    <div class="card" data-reveal style={`--reveal-delay: ${index * 120}ms`}>
      <picture>
        <Icon name={item.icon} width="48" height="48" aria-hidden="true" />
      </picture>
      <h2>{item.title}</h2>
      <p>{item.text}</p>
    </div>
  ))}
</section>

<style lang="less">
  /* Reveal: staggered entrance for the three cards (motion layer) */
  .card[data-reveal] {
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--reveal-delay, 0ms);

    &.cs-reveal-pending {
      opacity: 0;
      transform: translateY(16px);
    }

    &.cs-revealed {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<style lang="less">
  /*-- -------------------------- -->
<---          Services          -->
<--- -------------------------- -*/

  /* Mobile */
  @media only screen and (min-width: 0em) {
    .services {
      width: 90%;
      max-width: (1320/16em);
      margin: auto;
      margin-top: (-167/16em);
      margin-bottom: (50/16em);
      padding: (50/16em) (20/16em);
      background: #fff;
      box-shadow: 0px 20px 40px rgba(0, 0, 0, 0.05);
      border-top: (6/16em) solid var(--primary);
      border-radius: (5/16em);
      position: relative;
      z-index: 100;
      .card {
        width: 100%;
        max-width: (357/16em);
        margin: auto;
        margin-bottom: (50/16em);
        display: block;
        &:last-of-type {
          margin-bottom: 0;
        }

        picture {
          width: (88/16em);
          height: (88/16em);
          margin: auto;
          margin-bottom: (23/16em);
          background: var(--primary);
          border-radius: 50%;
          display: flex;
          justify-content: center;
          align-items: center;

          img {
            width: (48/16em);
            height: (48/16em);
          }
        }
        h2 {
          font-size: (32/16em);
          font-weight: 700;
          line-height: 27/20em;
          text-align: center;
          margin-bottom: 13/20em;
          color: #1a1a1a;
        }
        p {
          line-height: 24/18em;
          text-align: center;
          width: 100%;
          opacity: 0.7;
        }
      }
    }
  }

  /* Inbetween */
  @media only screen and (min-width: 768px) {
    .services {
      font-size: ~"min(1.8vw, 1em)";
      width: 98%;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;

      .card {
        max-width: (325/16em);
        margin: 0;
      }
    }
  }

  /* Large Desktop */
  @media only screen and (min-width: 1300px) {
    .services {
      padding: (50/16em) (80/16em);

      .card {
        max-width: (357/16em);
      }
    }
  }

  /* Dark mode */
  @media only screen and (min-width: 0em) {
    body.dark-mode {
      #services {
        background: var(--medium);

        picture {
          background: var(--primaryDark);
        }

        h2 {
          font-weight: bold;
          color: #fff;
        }
      }
    }
  }
</style>
