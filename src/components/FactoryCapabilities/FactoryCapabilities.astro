---
// FactoryCapabilities: production capability band for the factory page.
// Big static numbers (no count-up effects), revealed in sequence by the
// shared reveal layer. All styles are scoped.

interface CapabilityItem {
	number: string;
	unit: string;
	name: string;
	detail: string;
}

interface Props {
	capabilities: CapabilityItem[];
}

const { capabilities } = Astro.props as Props;
---

<section id="capability">
	<div class="cs-container">
		<div class="cs-content">
			<span class="cs-topper">生产能力</span>
			<h2 class="cs-title">15 亩厂区，6000㎡ 洁净车间</h2>
			<p class="cs-text">袋泡茶日产能 50 万包、罐装花茶 3 万罐、组合茶礼盒 1 万盒；原料处理区配备风选机、色选机、振动筛与臭氧清洗设备，全流程不落地生产。</p>
		</div>
		<div class="cs-cap-band">
			{capabilities.map((c) => (
				<div class="cs-cap">
					<span class="cs-cap-number">
						{c.number}
						<span class="cs-cap-unit">{c.unit}</span>
					</span>
					<h3 class="cs-cap-name">{c.name}</h3>
					<p class="cs-cap-detail">{c.detail}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style lang="less">
	/*-- -------------------------- -->
	<---    Capability Band        -->
	<--- -------------------------- -*/

	/* Mobile - 360px */
	@media only screen and (min-width: 0em) {
		#capability {
			padding: var(--sectionPadding);

			.cs-container {
				width: 100%;
				max-width: (1280/16rem);
				margin: auto;
				display: flex;
				flex-direction: column;
				align-items: center;
				row-gap: (48/16rem);
			}

			.cs-content {
				text-align: center;
				width: 100%;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.cs-topper {
				margin-bottom: (16/16rem);
			}

			.cs-title {
				max-width: (621/16rem);
				margin-bottom: (16/16rem);
			}

			.cs-text {
				max-width: (750/16rem);
			}

			.cs-cap-band {
				width: 100%;
				max-width: (1080/16rem);
				padding: (8/16rem) 0 0 0;
				border-top: 1px solid #e7e7e7;
				display: flex;
				justify-content: space-between;
				align-items: stretch;
				flex-wrap: wrap;
				gap: (28/16rem) (24/16rem);
			}

			.cs-cap {
				width: calc(50% - 0.75rem);
				box-sizing: border-box;
				padding-top: (28/16rem);
				border-top: 2px solid var(--primary);
				display: flex;
				flex-direction: column;
			}

			.cs-cap-number {
				font-size: (52/16rem);
				font-weight: 900;
				line-height: 1em;
				color: var(--secondary);
				display: block;
				margin-bottom: (10/16rem);
			}

			.cs-cap-unit {
				font-size: (18/16rem);
				font-weight: 700;
				margin-left: (6/16rem);
				color: var(--primary);
			}

			.cs-cap-name {
				font-size: (17/16rem);
				font-weight: 700;
				line-height: 1.3em;
				margin-bottom: (6/16rem);
				color: var(--headerColor);
			}

			.cs-cap-detail {
				font-size: (14/16rem);
				line-height: 1.5em;
				color: var(--bodyTextColor);
				opacity: 0.72;
			}
		}
	}

	/* Desktop - 1024px: one row */
	@media only screen and (min-width: 64rem) {
		#capability {
			.cs-cap {
				width: calc(25% - 1.125rem);
			}
		}
	}
</style>
